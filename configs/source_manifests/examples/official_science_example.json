  "quality_gate": {
    "accepted_min_score": 65,
    "review_min_score": 35,
    "allow_exploratory": true,
    "skip_rejected_allowed": true
  },
  "quality_notes": "Official science pages may use skip-rejected in explicit small batches after rejected samples are reviewed.",
  "fixture_candidates": "tests/fixtures/source_quality/official_science_example_candidates.json",
  "notes": "Example manifest only; replace domain and review robots/rate limits before real crawling."
