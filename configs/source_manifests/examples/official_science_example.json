{
  "source_name": "official_science_example",
  "source_mode": "official_science",
  "allowed_domains": ["science-agency.example.int"],
  "seed_urls": ["https://science-agency.example.int/space/mission/overview"],
  "include_path_keywords": ["space", "mission", "science", "planetary"],
  "exclude_path_keywords": ["newsroom", "media", "gallery", "video", "privacy", "/search", "/tag"],
  "max_depth": 2,
  "max_pages_per_run": 30,
  "max_discovery_fetch_pages": 5,
  "crawl_delay": 1.0,
