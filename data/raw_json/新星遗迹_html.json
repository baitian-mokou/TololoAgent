ass=\"mw-file-element\" data-file-height=\"40\" data-file-width=\"40\" decoding=\"async\" height=\"40\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/b/b4/Ambox_important.svg/40px-Ambox_important.svg.png\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/b/b4/Ambox_important.svg/120px-Ambox_important.svg.png 2x\" width=\"40\"/>\n        </span>\n       </span>\n      </div>\n     </td>\n     <td class=\"mbox-text\">\n      <div class=\"mbox-text-span\">\n       此條目需要\n       <b>\n        精通或熟悉相关主题的编者\n       </b>\n       参与及协助编辑。\n       <span class=\"hide-when-compact\">\n       </span>\n       <small class=\"date-container\">\n        <i>\n         (\n         <span class=\"date\">\n          2015年12月14日\n         </span>\n         )\n        </i>\n       </small>\n       <span class=\"hide-when-compact\">\n        <br/>\n        <small>\n         請\n         <a href=\"/wiki/Wikipedia:%E5%B0%88%E5%AE%B6%E9%82%80%E8%AB%8B%E5%B7%A5%E4%BD%9C%E5%B0%8F%E7%B5%84\" title=\"Wikipedia:專家邀請工作小組\">\n          邀請\n         </a>\n         適合的人士\n         <a class=\"external text\" data-mw-original-href=\"//zh.wikipedia.org/w/index.php?title=%E6%96%B0%E6%98%9F%E9%81%97%E8%BF%B9&amp;action=edit\" href=\"https://zh.wikipedia.org/w/index.php?title=%E6%96%B0%E6%98%9F%E9%81%97%E8%BF%B9&amp;action=edit\">\n          改善本条目\n         </a>\n         。更多的細節與詳情請參见\n         <a href=\"/wiki/Talk:%E6%96%B0%E6%98%9F%E9%81%97%E8%BF%B9\" title=\"Talk:新星遗迹\">\n          討論頁\n         </a>\n         。\n        </small>\n       </span>\n       <span class=\"hide-when-compact\">\n       </span>\n      </div>\n     </td>\n    </tr>\n   </tbody>\n  </table>\n  <figure typeof=\"mw:File/Thumb\">\n   <a class=\"mw-file-description\" href=\"/wiki/File:Tpyx_hst_big.jpg\">\n    <img class=\"mw-file-element\" data-file-height=\"470\" data-file-width=\"388\" decoding=\"async\" height=\"242\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0e/Tpyx_hst_big.jpg/250px-Tpyx_hst_big.jpg\" srcset=\"//upload.wikimedia.org/wikipedia/commons/0/0e/Tpyx_hst_big.jpg 2x\" width=\"200\"/>\n   </a>\n   <figcaption>\n    圍繞在反覆新星\n    <a href=\"/wiki/%E7%BE%85%E7%9B%A4%E5%BA%A7T\" title=\"羅盤座T\">\n     羅盤座T\n    </a>\n    周圍的新星殘骸。\n   </figcaption>\n  </figure>\n  <p>\n   <b>\n    新星殘骸\n   </b>\n   是恆星在經歷\n   <a href=\"/wiki/%E6%96%B0%E6%98%9F\" title=\"新星\">\n    新星\n   </a>\n   的巨大爆炸之後殘留下的物質，物質噴發的速度大約是1,000公里/秒。因為質量低於行星狀星雲和超新星殘骸，所以生命期僅約數個世紀，因此新星殘骸遠比行星狀星雲和超新星殘骸更為罕見。\n  </p>\n  <div class=\"mw-heading mw-heading2\">\n   <h2 id=\"參見\">\n    <span id=\".E5.8F.83.E8.A6.8B\">\n    </span>\n    參見\n   </h2>\n   <span class=\"mw-editsection\">\n    <span class=\"mw-editsection-bracket\">\n     [\n    </span>\n    <a href=\"/w/index.php?title=%E6%96%B0%E6%98%9F%E9%81%97%E8%BF%B9&amp;action=edit&amp;section=1\" title=\"编辑章节：參見\">\n     <span>\n      编辑\n     </span>\n    </a>\n    <span class=\"mw-editsection-bracket\">\n     ]\n    </span>\n   </span>\n  </div>\n  <ul>\n   <li>\n    <a href=\"/wiki/%E8%B6%85%E6%96%B0%E6%98%9F%E9%81%97%E8%BF%B9\" title=\"超新星遗迹\">\n     超新星遗迹\n    </a>\n   </li>\n   <li>\n    <a href=\"/wiki/%E8%A1%8C%E6%98%9F%E7%8A%B6%E6%98%9F%E4%BA%91\" title=\"行星状星云\">\n     行星状星云\n    </a>\n   </li>\n  </ul>\n  <div class=\"mw-heading mw-heading2\">\n   <h2 id=\"外部連結\">\n    <span id=\".E5.A4.96.E9.83.A8.E9.80.A3.E7.B5.90\">\n    </span>\n    外部連結\n   </h2>\n   <span class=\"mw-editsection\">\n    <span class=\"mw-editsection-bracket\">\n     [\n    </span>\n    <a href=\"/w/index.php?title=%E6%96%B0%E6%98%9F%E9%81%97%E8%BF%B9&amp;action=edit&amp;section=2\" title=\"编辑章节：外部連結\">\n     <span>\n      编辑\n     </span>\n    </a>\n    <span class=\"mw-editsection-bracket\">\n     ]\n    </span>\n   </span>\n  </div>\n  <ul>\n   <li>\n    <a class=\"external text\" href=\"http://hubblesite.org/newscenter/archive/releases/1997/29\" rel=\"nofollow\">\n     羅盤座T\n    </a>\n    （\n    <a class=\"external text\" href=\"//web.archive.org/web/20090207083020/http://hubblesite.org/newscenter/archive/releases/1997/29\" rel=\"nofollow\">\n     页面存档备份\n    </a>\n    ，存于\n    <a href=\"/wiki/%E4%BA%92%E8%81%94%E7%BD%91%E6%A1%A3%E6%A1%88%E9%A6%86\" title=\"互联网档案馆\">\n     互联网档案馆\n    </a>\n    ）新星殘骸（哈伯網頁）\n   </li>\n   <li>\n    <a class=\"external text\" href=\"https://web.archive.org/web/20080808120023/http://www.ociw.edu/news/zcam\" rel=\"nofollow\">\n     Double-star systems cycle between big and small blasts\n    </a>\n    （The Carnegie Observatories）\n   </li>\n   <li>\n    <a class=\"external text\" href=\"https://web.archive.org/web/20060705214728/http://www.site.uottawa.ca:4321/astronomy/index.html#novaremnant_table\" rel=\"nofollow\">\n     Nova Remnant comparison table\n    </a>\n    （UOttawa）\n   </li>\n   <li>\n    <a class=\"external text\" href=\"https://web.archive.org/web/20060705214728/http://www.site.uottawa.ca:4321/astronomy/index.html#novaremnant\" rel=\"nofollow\">\n     Nova Remnant\n    </a>\n    （UOttawa）\n   </li>\n  </ul>\n  <table class=\"metadata plainlinks stub\" role=\"presentation\" style=\"background:transparent\">\n   <tbody>\n    <tr class=\"noresize\">\n     <td>\n      <span typeof=\"mw:File\">\n       <a class=\"mw-file-description\" href=\"/wiki/File:Saturn_template.svg\">\n        <img alt=\"小作品圖示\" class=\"mw-file-element\" data-file-height=\"50\" data-file-width=\"50\" decoding=\"async\" height=\"30\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/d/df/Saturn_template.svg/40px-Saturn_template.svg.png\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/d/df/Saturn_template.svg/60px-Saturn_template.svg.png 2x\" width=\"30\"/>\n       </a>\n      </span>\n     </td>\n     <td style=\"font-size:smaller\">\n      这是一篇與\n      <a href=\"/wiki/%E5%A4%A9%E6%96%87%E5%AD%B8\" title=\"天文學\">\n       天文學\n      </a>\n      相關的\n      <a href=\"/wiki/Wikipedia:%E5%B0%8F%E4%BD%9C%E5%93%81\" title=\"Wikipedia:小作品\">\n       小作品\n      </a>\n      。您可以通过\n      <a class=\"external text\" data-mw-