card\" content=\"summary_large_image\">\n\t\t<meta name=\"twitter:site\" content=\"@esa\">\n\t\t\n\t<script>\nvar _paq = window._paq = window._paq || [];\n_paq.push([\"setDomains\", [\"*.www.esa.int\",\"*.www.esa.int\"]]);\n_paq.push([\"enableCrossDomainLinking\"]);\n_paq.push(['trackPageView']);\n_paq.push(['enableLinkTracking']);\n(function() {\tvar u=\"https://www-analytics.esa.int/\";\n\t_paq.push(['setTrackerUrl', u+'matomo.php']);\n\t_paq.push(['setSiteId', '46']);\n\tvar d=document, g=d.createElement('script'),\n\ts=d.getElementsByTagName('script')[0];\n\tg.type='text/javascript'; g.async=true; g.src=u+'matomo.js';\n\ts.parentNode.insertBefore(g,s);})();\n</script>\n\n</head>\n\t\n\n<body>\n\n\n<div class=\"wrapper popmod\">\n\t<div id=\"cookie_loc\"></div>\n\t\n\t\t\n\n<section id=\"esa-header\" class=\"esa-header exploring-discovering\">\n\t<div class=\"esa-header__left\">\n\t\t<button id=\"esa-menu\" class=\"esa-header__toggle menu-toggle\">\n\t\t\t<img class=\"esa-header__icon\" src=\"/extension/pillars/design/pillars/images/ESA_Menu.svg\" alt=\"ESA menu toggle\">\n\t\t</button>\n\t\t<button id=\"esa-search\" class=\"esa-header__toggle search-toggle\">\n\t\t\t<img class=\"esa-header__icon\" src=\"/extension/pillars/design/pillars/images/ESA_Search.svg\" alt=\"ESA search toggle\">\n\t\t</button>\n\t\t<img class=\"esa-header__title\" src=\"/extension/pillars/design/pillars/images/ESA_Title.svg\" alt=\"ESA title\">\n\t</div>\n\t<div class=\"esa-header__right\">\n\t\t<a class=\"esa-header__link\" href=\"/\">\n\t\t\t<img class=\"esa-header__logo\" src=\"/extension/pillars/design/pillars/images/ESA_Logo.svg\" alt=\"ESA logo\">\n\t\t</a>\n\t</div>\n</section>\n\n<form class=\"quick-search\" action=\"/esearch\">\n\t<input class=\"quick-search__field\" type=\"text\" name=\"q\" placeholder=\"Search ESA\">\n\t<button class=\"quick-search__submit\" type=\"submit\"><i class=\"far fa-arrow-right\"></i></button>\n</form>\n\t\n\t\n\t<script>\ntry {\tiniframe = window.self !== window.top;} catch (e) {\tiniframe = true;}if (!iniframe) {theme = 'exploring-discovering';\n$.get('/var/esa/storage/menu_overlay.html', for_overlay_menu);}</script>\n\n<section id=\"overlay-menu\"></section>\n\t\n\n\n\t\t<script>\n$.post(\n\t'/ezjscore/call', \n\t\"ezjscServer_function_arguments=esaux::viewsincr::139661\", \n\tfunction(data) { \n\t\t$(document).ready(function() {\t\t\t$('#viewcount').text(data)\n\t\t})\n\t})\n</script>\n\n\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\n\t  \n\n\t\t\t\t\t\t\t\n\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t<section class=\"feature feature--article\">\n\t<a href=\"/ESA_Multimedia/Images/2022/07/Ius_and_Tithonium_Chasmata_on_Mars\" class=\"popup\">\n\t\t<img class=\"image-bg stellar\" src=\"/var/esa/storage/images/esa_multimedia/images/2022/07/ius_and_tithonium_chasmata_on_mars/24373127-3-eng-GB/Ius_and_Tithonium_Chasmata_on_Mars_pillars.jpg\" alt=\"Ius and Tithonium Chasmata on Mars\" data-stellar-ratio=\"0.7\" data-stellar-vertical-offset=\"60\">\n\t</a>\n\t</section>\n\t\n\n<article class=\"article exploring-discovering\">\n\n<header class=\"entry article__block\">\n\t<span class=\"pillar article__item\">Science & Exploration</span>\n\t<h1 class=\"heading heading--main article__item\">Mars Express science highlights</h1>\n\t<div class=\"meta article__item\">\n\t\t\t\t<span><span id=\"viewcount\">55549</span><small> views</small></span>\n\t\t\t\t\t\t\t\t\t\t<span><span id=\"ezsr_total_6818348\">190</span><small> likes</small></span>\n\t\t\t\t\n\t</div>\n</header>\n<div class=\"breadcrumbs article__block article__item\">\n<a class=\"breadcrumbs__entry\" href=\"/\">ESA</a> /\t\t\t<a class=\"breadcrumbs__entry\" href=\"/Science_Exploration\">Science & Exploration</a> /\t\t\t<a class=\"breadcrumbs__entry\" href=\"/Science_Exploration/Space_Science\">Space Science</a> /\t\t\t<a class=\"breadcrumbs__entry\" href=\"/Science_Exploration/Space_Science/Mars_Express\">Mars Express</a></div>\n\n\n\n\n<div class=\"abstract article__block article__item\">\n\t<p>Mars Express has provided an unprecedented breadth and depth of information about Mars, from providing the most complete map of the chemical composition of the atmosphere, to tracing the history of water across the globe.</p>\n</div>\n\n\n\t\n    \n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\n\n\n\n\t\t\t\t\t\t\t\n\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"article__block\">\n\t\t\t\t<figure class=\"article__image article__image--large\">\n\t\t\t\t\t<a href=\"/ESA_Multimedia/Images/2023/05/20_years_and_counting_Mars_Express_in_numbers\" class=\"popup\">\n\t\t\t\t<img src=\"/var/esa/storage/images/esa_multimedia/images/2023/05/20_years_and_counting_mars_express_in_numbers/24894208-6-eng-GB/20_years_and_counting_Mars_Express_in_numbers_article.png\" alt=\"Mars Express in numbers, as of 2023\">\n\t\t\t</a>\n\t\t\t\t<figcaption class=\"image__caption\">\n\t\t\t\t\t\t\t<a href=\"/ESA_Multimedia/Images/2023/05/20_years_and_counting_Mars_Express_in_numbers\">Mars Express in numbers, as of 2023</a>\n\t\t\t\t\t\t\t\t</figcaption>\n\t</figure>\t\n\t\t<p>Some of the key results include:</p>\n<ul>\n\n<li>Producing&nbsp;<a href=\"http://www.esa.int/Our_Activities/Space_Science/Mars_Express/Ten_years_at_Mars_new_global_views_plot_the_Red_Planet_s_history\">global maps tracing the planet’s geologic activity, water, volcanism</a>&nbsp;and&nbsp;<a href=\"https://www.esa.int/Science_Exploration/Space_Science/Mars_Express/New_water_map_of_Mars_will_prove_invaluable_for_future_exploration\">minerals</a>.</li>\n\n<li>Providing enough data to construct thousands of&nbsp;<a href=\"http://www.esa.int/spaceinimages/Images/2018/01/Neukum_Crater_in_3D\">3D images of the surface</a>.</li>\n\n<li>Studying immense&nbsp;<a href=\"http://www.esa.int/Our_Activities/Space_Science/Mars_Express/Neighbouring_volcanoes_on_Mars\">volcanoes</a>,&nbsp;<a href=\"https://www.esa.int/Our_Activities/Space_Science/Mars_Express/Hebes_Chasma_a_trough_in_the_Grand_Canyon_of_Mars\">canyons</a>,&nbsp;<a href=\"http://www.esa.int/spaceinimages/Images/2015/02/Cappuccino_swirls_at_Mars_south_pole\">polar ice caps</a>, and ancient&nbsp;<a href=\"http://www.esa.int/Our_Activities/Space_Science/Mars_Express/The_scars_of_impacts_on_Mars\">impact craters</a>.</li>\n\n<li>Probing the&nbsp;<a href=\"http://www.esa.int/spaceinimages/Images/2018/04/Radar_echoes\">sub-surface with radar</a>, detecting&nbsp;<a href=\"https://www.esa.int/Science_Exploration/Space_Science/Results_from_Mars_Express_and_Huygens/Buried_craters_and_underground_ice_-_br_Mars_Express_uncovers_depths_of_Mars\">subsurface layers of water ice</a>&nbsp;and&nbsp;<a href=\"https://www.esa.int/Science_Exploration/Space_Science/Mars_Express/Mars_Express_detects_liquid_water_hidden_under_planet_s_south_pole\">liquid water hidden under the planet's south pole</a>.</li>\n\n<li>Explored the martian atmosphere, finding signs of&nbsp;<a href=\"https://www.esa.int/ESA_Multimedia/Images/2021/07/Understanding_ozone_on_Mars\">ozone</a>&nbsp;and&nbsp;<a href=\"http://www.esa.int/Our_Activities/Space_Science/Mars_Express/Water_and_methane_maps_overlap_on_Mars_a_new_clue\">methane</a>&nbsp;(which on Earth is attributed to active volcanism and biochemical processes),&nbsp;<a href=\"https://www.esa.int/Science_Exploration/Space_Science/Mars_Express/Rare_high-altitude_clouds_found_on_Mars\">fleeting cloud layers</a>&nbsp;up to 100 km above Mars' surface, and&nbsp;<a href=\"https://www.esa.int/Science_Exploration/Space_Science/Mars_Express/Dust_storms_swirl_at_the_north_pole_of_Mars\">mighty dust storms</a>.</li>\n\n<li>Witnessing&nbsp;<a href=\"http://www.esa.int/Our_Activities/Space_Science/Mars_Express/Leaky_atmosphere_linked_to_lightweight_planet\">charged particles escaping to space</a>.</li>\n\n<li>Finding the first evidence of a&nbsp;<a href=\"https://www.esa.int/Science_Exploration/Space_Science/Mars_Express/First_evidence_of_planet-wide_groundwater_system_on_Mars\">planet-wide groundwater system</a>. Five of these ancient interconnected underground lakes may contain minerals crucial to life.</li>\n\n<li>Examining Mars’ moons&nbsp;<a href=\"http://www.esa.int/Our_Activities/Space_Science/Mars_Express/Phobos_flyby_images\">Phobos</a>&nbsp;and&nbsp;<a href=\"http://www.esa.int/spaceinimages/Images/2009/12/Raw_and_processed_images\">Deimos</a>, with the revised mass and density data opening up the possibility that&nbsp;<a href=\"https://sci.esa.int/web/mars-express/-/51830-10-mapping-and-measuring-phobos-in-unprecedented-detail\">the interior of Phobos resembles a porous sponge</a>.</li>\n\n<li>Identifying&nbsp;<a href=\"http://www.esa.int/Our_Activities/Space_Science/Reull_Vallis_a_river_ran_through_it\">dried-up river valleys</a>,&nbsp;<a href=\"http://www.esa.int/Our_Activities/Space_Science/Mars_Express/Remnants_of_a_mega-flood_on_Mars\">traces of catastrophic floods</a>, and&nbsp;<a href=\"http://www.esa.int/Our_Activities/Space_Science/Mars_Express/Buried_glaciers_on_Mars\">buried glaciers</a>.</li>\n\n<li>Contributing to the&nbsp;<a href=\"http://sci.esa.int/mars-express/51820-science-highlights-from-mars-express/\">emerging picture of Mars</a>&nbsp;as a once-habitable planet, with warmer and wetter epochs that may have once acted as oases for ancient martian life.</li>\n\n<li>Discovering&nbsp;<a href=\"https://www.esa.int/Science_Exploration/Space_Science/Mars_Express/Mars_Express_discovers_aurorae_on_Mars\">localised aurora on Mars</a>.</li>\n\n<li>Unearthing the quantity and composition of ice at the polar regions, finding that there is&nbsp;<a href=\"https://www.esa.int/Science_Exploration/Space_Science/Mars_Express/Mars_Express_radar_gauges_water_quantity_around_Mars_south_pole\">enough water ice in the south polar cap to create a global ocean 11-metres deep</a>.</li>\n\n<li>Detecting&nbsp;<a href=\"https://www.esa.int/Science_Exploration/Space_Science/Mars_Express/Mars_Express_reveals_the_Red_Planet_s_volcanic_past\">volcanic activity as recently as 100 million years ago</a>, leading to speculation that they may still be active today.</li>\n\n<li>Finding water <a href=\"/Science_Exploration/Space_Science/Mars_Express/Buried_water_ice_at_Mars_s_equator\">buried under the equator</a> and&nbsp;<a href=\"/Science_Exploration/Space_Science/Mars_Express/Frosty_volcanoes_discovered_in_Mars_s_tropics\">inside volcanoes near the equator</a>, a place where it was thought impossible for water to exist.</li>\n\n<li>Providing hints that Mars <a href=\"/Science_Exploration/Space_Science/Mars_Express/Have_we_been_wrong_about_why_Mars_is_red\">rusted earlier than thought</a> in the planet's past, when liquid water was more widespread.</li>\n\n<li>Revealing that&nbsp;<a href=\"/Science_Exploration/Space_Science/Mars_Express/Martian_dust_storms_churn_up_Earth-like_clouds\">Mars churns up surprisingly Earth-like cloud patterns</a>, reminiscent of those in our planet’s tropical regions.</li>\n\n</ul>\n<p>Mars Express's discoveries are paving the way for missions dedicated to hunting for signs of life on the planet,&nbsp;such as the <a href=\"https://www.esa.int/Science_Exploration/Human_and_Robotic_Exploration/Exploration/ExoMars\">ExoMars</a> Trace Gas Orbiter and Rosalind Franklin rover mission.</p>\t</div>\t\n    \n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\n\n\n\n\t\t\t\t\t\t\t\n\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"article__block\">\n\t\t\t\t<figure class=\"article__image article__image--large\">\n\t\t\t\t\t<a href=\"/ESA_Multimedia/Images/2013/05/Mars_Express_mission_highlights\" class=\"popup\">\n\t\t\t\t<img src=\"/var/esa/storage/images/esa_multimedia/images/2013/05/mars_express_mission_highlights/12854412-1-eng-GB/Mars_Express_mission_highlights_article.jpg\" alt=\"Mars Express highlight